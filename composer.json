{
  "name": "p3k/xray",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/aaronpk/XRay",
  "description": "X-Ray returns structured data from any URL",
  "require": {
    "php": "^8.0",
    "mf2/mf2": "^0.4||^0.5",
    "ezyang/htmlpurifier": "^4.17",
    "indieweb/link-rel-parser": "^0.1.0",
    "p3k/http": "^0.1.13",
    "cebe/markdown": "^1.1.0",
    "p3k/picofeed": "0.1.41",
    "masterminds/html5": "^2.3"
  },
  "autoload": {
    "psr-4": {
      "p3k\\XRay\\": "lib/XRay"
    },
    "files": [
      "lib/helpers.php",
      "lib/XRay.php"
    ]
  },
  "require-dev": {
    "league/plates": "^3.5",
    "symfony/http-foundation": "^5.4 || ^6.0 || ^7.0",
    "phpunit/phpunit": "^9.6"
  },
  "autoload-dev": {
    "files": [
      "controllers/Main.php",
      "controllers/Parse.php",
      "controllers/Token.php",
      "controllers/Rels.php",
      "controllers/Feeds.php",
      "controllers/Certbot.php"
    ]
  },
  "config": {
    "platform": {
      "php": "8.0.2"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit"
  }
}
